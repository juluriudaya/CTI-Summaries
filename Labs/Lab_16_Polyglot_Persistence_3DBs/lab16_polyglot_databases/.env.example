# MongoDB connection. For local MongoDB:
MONGODB_URI=mongodb://localhost:27017

# Optional: configure these only if you want Lab 16.2 to use a live Neo4j server.
# If NEO4J_URI is not set (or the neo4j package is unavailable), the lab uses
# its built-in in-memory graph fallback.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change_this_password
