# Optional local overrides. No API keys are required for the four scheduled public feeds.
# Docker Compose uses the service name 'mongo' for the MongoDB connection.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=cyber_threat_intelligence
# Optional: free abuse.ch Auth-Key for MalwareBazaar SHA-256/SHA-1/MD5 hash feed. Leave blank to keep all scheduled feeds keyless.
MALWAREBAZAAR_AUTH_KEY=
# Six hours = 21600 seconds. For testing, temporarily use 300 (5 minutes).
SYNC_INTERVAL_SECONDS=21600
# Set this to your Docker Hub username before building/pushing the image.
DOCKERHUB_USERNAME=your-dockerhub-username
